PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback

JWT_SECRET=replace_this_with_a_long_random_secret
SESSION_TTL_SECONDS=604800
OAUTH_STATE_TTL_SECONDS=600

ALLOWED_RETURN_PREFIXES=ota-connect://auth,exp://,ota-connect-mobile://auth,http://localhost

# Optional horizontal scaling
REDIS_URL=

# Optional production RTC config
# Preferred: full JSON array of RTCIceServer objects
RTC_ICE_SERVERS_JSON=

# Simpler TURN fallback if you do not want JSON
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
